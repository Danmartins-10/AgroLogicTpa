{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "agropreco/api",
  "type": "project",
  "description": "API REST do projeto AgroPreço - atividade integrada de Projeto de Software",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.4"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
